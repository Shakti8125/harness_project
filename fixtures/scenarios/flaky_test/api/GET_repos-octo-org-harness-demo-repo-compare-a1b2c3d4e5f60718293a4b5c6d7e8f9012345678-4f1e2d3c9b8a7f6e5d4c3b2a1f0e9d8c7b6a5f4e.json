      "blob_url": "https://github.com/octo-org/harness-demo-repo/blob/4f1e2d3c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e/src/pricing/format.py",
      "raw_url": "https://github.com/octo-org/harness-demo-repo/raw/4f1e2d3c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e/src/pricing/format.py",
      "contents_url": "https://api.github.com/repos/octo-org/harness-demo-repo/contents/src/pricing/format.py?ref=4f1e2d3c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e",
      "patch": "@@ -1,9 +1,11 @@\n+import os\n+\n+SEPARATOR = os.environ.get(\"PRICING_SEPARATOR\", \"\\u2009\")\n+\n \n def format_price(minor_units: int) -> str:\n     \"\"\"Render an integer number of cents as a human-readable price.\"\"\"\n     whole, cents = divmod(minor_units, 100)\n-    grouped = f\"{whole:,}\"\n-    return f\"{grouped}.{cents:02d}\"\n+    return f\"{whole:,}.{cents:02d}\".replace(\",\", SEPARATOR)\n"
