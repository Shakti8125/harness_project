# Copy this file to `.env` and fill in real values for local development.
# `.env` itself is gitignored — never commit real secrets.
# See PLAN.md Appendix E for the full field list and where each value belongs
# (local dev / docker / fly.io).

# --- secrets (required — the app refuses to start without these) ---
HARNESS_GEMINI_API_KEY=AIza...replace-me
HARNESS_GITHUB_TOKEN=ghp_...replace-me
HARNESS_GITHUB_WEBHOOK_SECRET=replace-me-with-a-random-string
# Optional: a webhook URL for escalation notifications (e.g. Slack incoming webhook).
# HARNESS_ESCALATION_WEBHOOK_URL=https://hooks.example.com/replace-me

# --- non-secret config (defaults shown; uncomment to override) ---
# HARNESS_DATABASE_PATH=./data/harness.db
# HARNESS_GEMINI_MODEL=gemini-3.6-flash
# HARNESS_MODEL_INVESTIGATOR=
# HARNESS_MODEL_DIAGNOSTICIAN=
# HARNESS_MODEL_REMEDIATOR=
# HARNESS_ESCALATION_THRESHOLD=0.70
# HARNESS_LOG_CHAR_BUDGET=120000
# HARNESS_GEMINI_TIMEOUT_S=60.0
# HARNESS_GITHUB_TIMEOUT_S=30.0
# HARNESS_GITHUB_API_BASE=https://api.github.com
# HARNESS_ALLOWED_REPOS=[]
# This field is a JSON list, not a bare string — quote and bracket it:
# HARNESS_ALLOWED_REPOS=["octo-org/harness-demo-repo"]
# HARNESS_GATEWAY=replay
# HARNESS_DRY_RUN=true
# HARNESS_MAX_CONCURRENT_RUNS=4
# HARNESS_APPROVAL_TTL_H=24
# HARNESS_FAULT_INJECT=
# HARNESS_ENV=dev
# HARNESS_LOG_LEVEL=INFO
